# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api
# 接口地址
VITE_GLOB_OTHER_API_URL=/platform
VITE_GLOB_AUTH_API_URL = /auth
VITE_GLOB_CLOUD_API_URL = /cloud
# Social 接口地址（登录等，开发环境走 Vite 代理避免 CORS）
VITE_GLOB_SOCIAL_API_URL=/social
# OSS 访问前缀（账号 logo）
VITE_OSS_BASE_URL=http://172.25.1.213:8889
# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
VITE_APP_TARGET_URL_RTMP=test.callfansai.cn
