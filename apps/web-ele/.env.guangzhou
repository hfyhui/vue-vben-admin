# 广州环境（与 production 同级，通过打包命令选用：pnpm build:guangzhou）
VITE_BASE=/platform_admin/

# 接口地址（广州内网）
VITE_GLOB_API_URL=https://mock-napi.vben.pro/api
# OSS 访问前缀（账号 logo）
VITE_OSS_BASE_URL=http:172.25.0.30
VITE_GLOB_AUTH_API_URL = /auth
VITE_GLOB_OTHER_API_URL=/platform
# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
